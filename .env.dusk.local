# Umgebung für Laravel Dusk (sail dusk): Dusk ersetzt während des Laufs die .env durch diese Datei.
# Keine Geheimnisse, keine echten Dienste. Der Browser (Selenium-Container) ruft die App unter laravel.test auf.
APP_NAME=Itelfingen
APP_ENV=local
APP_KEY=base64:oX+/+DJxLW1xjpzrEWtIYiSSHntWOdCDx/hPBa+O8Co=
APP_DEBUG=true
APP_URL=http://laravel.test
APPLICATION_ENABLED=true
DISCOUNT_ENABLED=false

# SQLite als Datei: Testprozess und Webserver müssen dieselbe Datenbank sehen (in-memory geht nicht)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/database/dusk.sqlite

# array: Zähler der Anfrage-Begrenzung (throttle) nicht über Tests hinweg behalten (config/cache.php liest CACHE_DRIVER)
CACHE_DRIVER=array
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=test@example.com
MAIL_FROM_NAME=Itelfingen
TELESCOPE_ENABLED=false
BCRYPT_ROUNDS=4

# Spam-Schutz würde schnelle Formulareingaben des Browsers abweisen
HONEYPOT_ENABLED=false

ADMIN_PASSWORD=password
API_TOKEN=test-api-token

# Externe Dienste: keine echten Endpunkte
DEFAULT_SLACK_WEBHOOK_ENDPOINT=
GLUTZ_URL=http://glutz.test
GLUTZ_USERNAME=glutz
GLUTZ_PASSWORD=glutz
BEXIO_CLIENT_ID=bexio-client
BEXIO_CLIENT_SECRET=bexio-secret
BEXIO_TOKEN=
GOOGLE_CALENDAR_ID=
SPREADSHEET_ID=test-spreadsheet
RECAPTCHA_SECRET_KEY=

# Sail: Selenium statt lokalem ChromeDriver
DUSK_DRIVER_URL=http://selenium:4444/wd/hub
