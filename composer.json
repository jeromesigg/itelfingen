{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "consoletvs/charts": "6.*",
        "fakerphp/faker": "^1.15.0",
        "intervention/image": "^2.5",
        "jeremykenedy/slack-laravel": "^2.6",
        "laravel/framework": "^13.0",
        "laravel/slack-notification-channel": "^3.4",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.0",
        "maatwebsite/excel": "^4.0",
        "nicolaslopezj/searchable": "^1.13",
        "nunomaduro/collision": "^8.1",
        "revolution/laravel-google-sheets": "^7.0",
        "setasign/fpdf": "^1.8",
        "setasign/fpdi": "^2.3",
        "simonschaufi/laravel-dkim": "*",
        "spatie/icalendar-generator": "^2.4",
        "spatie/laravel-google-calendar": "^3.3",
        "spatie/laravel-honeypot": "^4.5"
    },
    "require-dev": {
        "laravel/boost": "^2.4",
        "laravel/dusk": "^8.7",
        "laravel/pint": "^1.2",
        "laravel/sail": "^1.13",
        "laravel/telescope": "^5.20",
        "mockery/mockery": "^1.3.1",
        "phpunit/phpunit": "^11.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "process-timeout": 1800
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                 "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-install-cmd": [
            "@php -r \"is_dir('.git') && exec('git config core.hooksPath .githooks');\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
